FOLDERS = env.FOLDERS
DESTINATION = env.DESTINATION
SOURCE = env.SOURCE

node('rsync') {
    sshagent(credentials: ['apoc-ssh-key']) {

        withCredentials([
            file(
                credentialsId: 'apoc-known-hosts',
                variable: 'KNOWN_HOSTS'
            )
        ]) {
            for(String folder : FOLDERS.split(",")) {
                stage("Rsync ${folder}") {
                    sh """rsync -av -e "ssh -o BatchMode=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=\$KNOWN_HOSTS" ${SOURCE}:${folder} ${DESTINATION}"""
                }
            }
        }
    }
}
